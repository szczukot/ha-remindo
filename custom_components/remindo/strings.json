  "services": {
    "add": {
      "name": "Add task",
      "description": "Adds a task with reminders.",
      "fields": {
        "summary": {
          "name": "Summary",
          "description": "What to do."
        },
        "description": {
          "name": "Description",
          "description": "Extra info."
        },
        "start": {
          "name": "Start",
          "description": "When reminders start: datetime, date or 'now'. Empty = note."
        },
        "interval": {
          "name": "Interval (min)",
          "description": "Repeat every N minutes until handled. 0 = once."
        },
        "key": {
          "name": "Key",
          "description": "Prevents duplicates; allows auto close."
        },
        "repeat": {
          "name": "Repeat",
          "description": "After done, task returns at the next date."
        },
        "repeat_every": {
          "name": "Every",
          "description": "E.g. 3 with monthly = every 3 months."
        },
        "tts": {
          "name": "Spoken",
          "description": "Speak on the tablet when someone is home."
        },
        "tts_message": {
          "name": "Spoken text",
          "description": "Different text to speak."
        },
        "push": {
          "name": "Push",
          "description": "Send phone notification."
        },
        "phones": {
          "name": "Phones",
          "description": "Which phones get the push (empty = none; omitted = all configured)."
        },
        "speakers": {
          "name": "Speakers",
          "description": "Where to speak (omitted = all configured)."
        }
      }
    },
    "done": {
      "name": "Done",
      "description": "Marks task done.",
      "fields": {
        "uid": {
          "name": "UID",
          "description": "Task id."
        },
        "key": {
          "name": "Key",
          "description": "Key given when adding (e.g. gate)."
        }
      }
    },
    "dismiss": {
      "name": "Dismiss",
      "description": "Dismisses the task.",
      "fields": {
        "uid": {
          "name": "UID",
          "description": "Task id."
        },
        "key": {
          "name": "Key",
          "description": "Key given when adding (e.g. gate)."
        }
      }
    },
    "snooze": {
      "name": "Snooze",
      "description": "Postpones the next reminder.",
      "fields": {
        "uid": {
          "name": "UID",
          "description": "Task id."
        },
        "key": {
          "name": "Key",
          "description": "Key given when adding (e.g. gate)."
        },
        "minutes": {
          "name": "Minutes",
          "description": "Remind in N minutes."
        },
        "until": {
          "name": "Until",
          "description": "Specific time or date."
        }
      }
    },
    "close_by_key": {
      "name": "Close by key",
      "description": "Closes the open task with this key.",
      "fields": {
        "key": {
          "name": "Key",
          "description": "Key given when adding (e.g. gate)."
        }
      }
    }
  },
  "selector": {
    "repeat": {
      "options": {
        "none": "One-off",
        "hourly": "Hourly",
        "daily": "Daily",
        "weekly": "Weekly",
        "monthly": "Monthly",
        "yearly": "Yearly"
      }
    },
    "rule_mode": {
      "options": {
        "state": "Has a state",
        "above": "Is above",
        "below": "Is below",
        "calendar": "Has a calendar event"
      }
    }
  },
  "config_subentries": {
    "rule": {
      "entry_type": "Rule",
      "initiate_flow": {
        "user": "Add rule",
        "reconfigure": "Edit rule"
      },
      "step": {
        "trigger": {
          "title": "New rule — when?",
          "description": "A task is added automatically when the entity meets the condition.",
          "data": {
            "summary": "Task summary",
            "entity_id": "Entity (device, sensor, calendar)",
            "mode": "Condition"
          },
          "data_description": {
            "summary": "E.g. \"Unload the dishwasher\". For calendars the event names are appended."
          }
        },
        "condition_state": {
          "title": "Condition",
          "description": "Entity: {entity} (now: {current})",
          "data": {
            "value": "Has state",
            "for_minutes": "For at least (min)"
          },
          "data_description": {
            "for_minutes": "0 = immediately."
          }
        },
        "condition_number": {
          "title": "Condition",
          "description": "Entity: {entity} (now: {current})",
          "data": {
            "value": "Threshold",
            "for_minutes": "For at least (min)"
          },
          "data_description": {
            "for_minutes": "0 = immediately."
          }
        },
        "condition_calendar": {
          "title": "Calendar",
          "description": "Calendar: {entity}",
          "data": {
            "days_before": "Days before the event",
            "at_time": "At",
            "contains": "Only events containing (optional)"
          },
          "data_description": {
            "days_before": "1 = the day before, 0 = on the day.",
            "contains": "Empty = all events."
          }
        },
        "notify": {
          "title": "Reminders",
          "data": {
            "remind": "Repeat reminder",
            "interval": "Every (min)",
            "max_reminders": "At most times",
            "phones": "Phones (push)",
            "speakers": "Speakers (announcement)",
            "auto_close": "Close the task when the condition ends"
          },
          "data_description": {
            "remind": "Off = remind once.",
            "max_reminders": "Empty = until done.",
            "phones": "None selected = list only.",
            "auto_close": "For calendars: after the event day."
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Rule saved."
      }
    }
  },
  "entity": {
    "sensor": {
      "active": {
        "name": "Remindo active",
        "unit_of_measurement": "tasks"
      }
    }
  },
  "exceptions": {
    "not_loaded": {
      "message": "The Remindo integration is not loaded"
    },
    "task_not_found": {
      "message": "No open task found (uid={uid}, key={key})"
    },
    "invalid_start": {
      "message": "Unknown start format: {start}. Use now, a date (2026-12-01) or a date with time (2026-12-01T18:00)."
    },
    "repeat_needs_start": {
      "message": "A recurring task needs a start date"
    }
  }
}
