        },
        "push": {
          "name": "Push",
          "description": "Send phone notification."
        },
        "phones": {
          "name": "Phones",
          "description": "Which phones get the push (empty = none; omitted = all configured)."
        },
        "speakers": {
          "name": "Speakers",
          "description": "Where to speak (omitted = all configured)."
        }
      }
    },
